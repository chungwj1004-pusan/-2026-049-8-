        "%%writefile app.py\n",
        "import os\n",
        "import re\n",
        "import time\n",
        "import streamlit as st\n",
        "from PIL import Image, ImageOps\n",
        "from google import genai\n",
        "from google.genai import types\n",
        "\n",
        "# ==============================================================================\n",
        "# [1. API 키 설정 및 전역 상수]\n",
        "# 코드 최상단에 GEMINI_API_KEY 변수를 배치하고 .strip()으로 공백·개행을 제거합니다.\n",
        "# 코랩 실행 시 아래 문자열에 본인의 API 키를 직접 입력하거나 환경 변수로 전달할 수 있습니다.\n",
        "# ==============================================================================\n",
        "GEMINI_API_KEY = os.environ.get(\"GEMINI_API_KEY\", \"YOUR_GEMINI_API_KEY\").strip()\n",
        "\n",
        "# 이미지 전송 속도 및 멀티모달 API 안정성 확보를 위한 최대 해상도 기준\n",
        "MAX_IMAGE_SIZE = (1200, 1200)\n",
        "\n",
        "# 변형 문제 본문과 정답·해설 영역을 분리하기 위한 내부 구분자\n",
        "SOLUTION_DIVIDER = \"===SOLUTION_DIVIDER===\"\n",
        "\n",
        "# 표준 4대 오답 분류 태그 정의\n",
        "ERROR_TAGS = {\n",
        "    \"#개념_오개념\": \"공식·정리·물리 법칙의 성립 조건이나 정의 자체를 잘못 이해하여 적용한 경우\",\n",
        "    \"#조건_해석_누락\": \"초기 조건, 단위 환산(SI 단위 등), 경계 조건, 부호 제약을 놓치거나 잘못 대입한 경우\",\n",
        "    \"#계산_전개_실수\": \"접근 식은 타당했으나 미적분·행렬 연산, 이항, 대수 전개 과정에서 수치 오류가 발생한 경우\",\n",
        "    \"#접근_전략_부재\": \"주어진 문제 조건을 수식화하지 못해 첫 식을 세우지 못했거나 잘못된 풀이 경로로 진입한 경우\",\n",
        "}\n",
        "\n",
        "# 전공 과목별 동적 코치 페르소나 매핑\n",
        "SUBJECT_PERSONAS = {\n",
        "    \"물리학 (역학/전자기학 등)\": {\n",
        "        \"role\": \"이공계 대학 물리학 전담 튜터\",\n",
        "        \"focus\": \"자유물체도·장(Field) 설정, SI 표준 단위계 환산, 벡터 방향 및 부호 규약, 보존 법칙 성립 조건을 엄밀하게 점검합니다.\",\n",
        "        \"placeholder\": \"예: 2번째 줄에서 역학적 에너지 보존식을 세울 때 비보존력 조건이 빠졌는지 확인하고 싶습니다.\",\n",
        "    },\n",
        "    \"대학 수학 (미적분/선형대수 등)\": {\n",
        "        \"role\": \"이공계 대학 수학 전담 튜터\",\n",
        "        \"focus\": \"정리(Theorem) 적용의 전제 조건, 극한·미적분 연산의 동치 변형, 행렬 차원 및 기저 변환의 논리적 비약을 집중 분석합니다.\",\n",
        "        \"placeholder\": \"예: 치환적분 구간을 변경한 3번째 줄에서 부호 처리가 올바른지 검토를 요청합니다.\",\n",
        "    },\n",
        "    \"일반 프로그래밍/기타 전공\": {\n",
        "        \"role\": \"이공계 전공 문제 해결 코치\",\n",
        "        \"focus\": \"입력 제약 조건 해석, 알고리즘 시간·공간 복잡도, 경계값(Edge Case) 누락 및 수식·논리 전개의 일관성을 정밀 진단합니다.\",\n",
        "        \"placeholder\": \"예: 점화식 초기항 설정과 경계 조건 분기 처리에서 오류가 발생한 지점을 알고 싶습니다.\",\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# [2. 페이지 기본 설정 및 세션 상태(Session State) 초기화]\n",
        "# 중복 클릭 잠금(is_busy), 진행률 표시, 2단계 검수 데이터를 안전하게 관리합니다.\n",
        "# ==============================================================================\n",
        "st.set_page_config(\n",
        "    page_title=\"오답 원인 진단 및 개념 코치\",\n",
        "    layout=\"wide\",\n",
        "    initial_sidebar_state=\"expanded\",\n",
        ")\n",
        "\n",
        "\n",
        "def init_session_state() -> None:\n",
        "    \"\"\"웹앱 실행에 필요한 모든 세션 상태 변수를 초기화합니다.\"\"\"\n",
        "    defaults = {\n",
        "        \"ocr_editor\": \"\",\n",
        "        \"user_memo\": \"\",\n",
        "        \"ocr_completed\": False,\n",
        "        \"diagnosis_main\": \"\",\n",
        "        \"diagnosis_solution\": \"\",\n",
        "        \"detected_tags\": [],\n",
        "        \"active_model\": \"자동 탐색 대기\",\n",
        "        \"notice_type\": \"\",\n",
        "        \"notice_title\": \"\",\n",
        "        \"notice_message\": \"\",\n",
        "        \"is_busy\": False,\n",
        "        \"pending_action\": None,\n",
        "        \"uploader_key_ver\": 0,\n",
        "        \"_staged_ocr_text\": None,\n",
        "    }\n",
        "    for key, default_val in defaults.items():\n",
        "        if key not in st.session_state:\n",
        "            st.session_state[key] = default_val\n",
        "\n",
        "    # 위젯 렌더링 이전에 스테이징된 판독 텍스트를 반영하여 위젯 키 충돌 방지\n",
        "    if st.session_state[\"_staged_ocr_text\"] is not None:\n",
        "        st.session_state[\"ocr_editor\"] = st.session_state[\"_staged_ocr_text\"]\n",
        "        st.session_state[\"_staged_ocr_text\"] = None\n",
        "\n",
        "\n",
        "def reset_workspace() -> None:\n",
        "    \"\"\"사이드바 초기화 버튼 클릭 시 업로드 파일과 모든 판독·진단 상태를 재설정합니다.\"\"\"\n",
        "    st.session_state[\"ocr_editor\"] = \"\"\n",
        "    st.session_state[\"user_memo\"] = \"\"\n",
        "    st.session_state[\"ocr_completed\"] = False\n",
        "    st.session_state[\"diagnosis_main\"] = \"\"\n",
        "    st.session_state[\"diagnosis_solution\"] = \"\"\n",
        "    st.session_state[\"detected_tags\"] = []\n",
        "    st.session_state[\"notice_type\"] = \"\"\n",
        "    st.session_state[\"notice_title\"] = \"\"\n",
        "    st.session_state[\"notice_message\"] = \"\"\n",
        "    st.session_state[\"is_busy\"] = False\n",
        "    st.session_state[\"pending_action\"] = None\n",
        "    st.session_state[\"_staged_ocr_text\"] = None\n",
        "    st.session_state[\"uploader_key_ver\"] += 1\n",
        "\n",
        "\n",
        "def trigger_ocr_action() -> None:\n",
        "    \"\"\"0단계 버튼 클릭 시 중복 실행을 잠그고 이미지 판독 작업을 예약합니다.\"\"\"\n",
        "    st.session_state[\"is_busy\"] = True\n",
        "    st.session_state[\"pending_action\"] = \"ocr\"\n",
        "    st.session_state[\"notice_type\"] = \"\"\n",
        "    st.session_state[\"notice_title\"] = \"\"\n",
        "    st.session_state[\"notice_message\"] = \"\"\n",
        "\n",
        "\n",
        "def trigger_diagnosis_action() -> None:\n",
        "    \"\"\"1단계 버튼 클릭 시 중복 실행을 잠그고 정밀 진단 작업을 예약합니다.\"\"\"\n",
        "    st.session_state[\"is_busy\"] = True\n",
        "    st.session_state[\"pending_action\"] = \"diagnose\"\n",
        "    st.session_state[\"notice_type\"] = \"\"\n",
        "    st.session_state[\"notice_title\"] = \"\"\n",
        "    st.session_state[\"notice_message\"] = \"\"\n",
        "\n",
        "\n",
        "init_session_state()\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# [3. 커스텀 디자인 시스템 CSS 주입 (프로그래스 바 & TypeError 예외 카드 재정의 포함)]\n",
        "# 단일 액센트(#0066cc), Pretendard 한영 매칭, 다크 모드 색상 간섭 차단,\n",
