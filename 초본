        "            font-size: 14.5px !important;\n",
        "        }\n",
        "\n",
        "        li[role=\"option\"][aria-selected=\"true\"] {\n",
        "            background-color: var(--color-parchment) !important;\n",
        "            color: var(--color-primary) !important;\n",
        "            font-weight: 600 !important;\n",
        "        }\n",
        "\n",
        "        /* 파일 업로더 및 업로드된 파일 칩(다크 배경 방지) 정돈 */\n",
        "        [data-testid=\"stFileUploaderDropzone\"] {\n",
        "            background-color: var(--color-parchment) !important;\n",
        "            border: 1px solid var(--color-hairline) !important;\n",
        "            border-radius: var(--radius-md) !important;\n",
        "            padding: 14px !important;\n",
        "            box-shadow: none !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stFileUploaderDropzone\"] * {\n",
        "            color: var(--color-ink-muted-80) !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stFileUploaderDropzone\"] button {\n",
        "            border-radius: var(--radius-pill) !important;\n",
        "            min-height: 38px !important;\n",
        "            border: 1px solid var(--color-primary) !important;\n",
        "            color: var(--color-primary) !important;\n",
        "            background: var(--color-canvas) !important;\n",
        "            box-shadow: none !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stFileUploaderFile\"] {\n",
        "            background-color: var(--color-canvas) !important;\n",
        "            border: 1px solid var(--color-hairline) !important;\n",
        "            border-radius: var(--radius-md) !important;\n",
        "            padding: 8px 12px !important;\n",
        "            margin-top: 6px !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stFileUploaderFile\"] * {\n",
        "            color: var(--color-ink) !important;\n",
        "        }\n",
        "\n",
        "        /* 버튼 시스템: 단일 Action Blue(#0066cc) 캡슐형(9999px) 및 최소 44px 터치 영역 */\n",
        "        .stButton > button,\n",
        "        [data-testid=\"stFormSubmitButton\"] > button {\n",
        "            min-height: 46px !important;\n",
        "            padding: 11px 22px !important;\n",
        "            border-radius: var(--radius-pill) !important;\n",
        "            font-size: 16px !important;\n",
        "            font-weight: 600 !important;\n",
        "            letter-spacing: -0.015em !important;\n",
        "            box-shadow: none !important;\n",
        "            transition: transform 0.12s ease, opacity 0.12s ease !important;\n",
        "        }\n",
        "\n",
        "        .stButton > button[kind=\"primary\"],\n",
        "        [data-testid=\"stFormSubmitButton\"] > button[kind=\"primary\"] {\n",
        "            background-color: var(--color-primary) !important;\n",
        "            color: #ffffff !important;\n",
        "            -webkit-text-fill-color: #ffffff !important;\n",
        "            border: 1px solid var(--color-primary) !important;\n",
        "        }\n",
        "\n",
        "        .stButton > button[kind=\"secondary\"],\n",
        "        [data-testid=\"stFormSubmitButton\"] > button[kind=\"secondary\"] {\n",
        "            background-color: var(--color-pearl) !important;\n",
        "            color: var(--color-ink-muted-80) !important;\n",
        "            -webkit-text-fill-color: var(--color-ink-muted-80) !important;\n",
        "            border: 1px solid var(--color-hairline) !important;\n",
        "        }\n",
        "\n",
        "        .stButton > button:active:not(:disabled),\n",
        "        [data-testid=\"stFormSubmitButton\"] > button:active:not(:disabled) {\n",
        "            transform: scale(0.97) !important;\n",
        "        }\n",
        "\n",
        "        .stButton > button:focus-visible,\n",
        "        [data-testid=\"stFormSubmitButton\"] > button:focus-visible,\n",
        "        summary:focus-visible {\n",
        "            outline: 2px solid var(--color-primary-focus) !important;\n",
        "            outline-offset: 2px !important;\n",
        "        }\n",
        "\n",
        "        .stButton > button:disabled,\n",
        "        [data-testid=\"stFormSubmitButton\"] > button:disabled {\n",
        "            background-color: var(--color-parchment) !important;\n",
        "            color: var(--color-ink-muted-48) !important;\n",
        "            -webkit-text-fill-color: var(--color-ink-muted-48) !important;\n",
        "            border-color: var(--color-hairline) !important;\n",
        "            opacity: 0.8 !important;\n",
        "            cursor: not-allowed !important;\n",
        "        }\n",
        "\n",
        "        /* ======================================================================\n",
        "           [실시간 프로그래스 바(st.progress) 커스텀 스타일링]\n",
        "           캡슐형 트랙(#e5e5ea) + 단일 Action Blue(#0066cc) 채움 + 고정폭 퍼센트 정렬\n",
        "           ====================================================================== */\n",
        "        .progress-tracker-header {\n",
        "            background-color: var(--color-parchment);\n",
        "            border: 1px solid var(--color-hairline);\n",
        "            border-radius: var(--radius-md);\n",
        "            padding: 12px 16px;\n",
        "            margin-top: 14px;\n",
        "            margin-bottom: 8px;\n",
        "        }\n",
        "\n",
        "        .progress-meta-top {\n",
        "            display: flex;\n",
        "            align-items: center;\n",
        "            justify-content: space-between;\n",
        "            gap: 12px;\n",
        "            margin-bottom: 4px;\n",
        "        }\n",
        "\n",
        "        .progress-stage-badge {\n",
        "            font-size: 11px;\n",
        "            font-weight: 600;\n",
        "            letter-spacing: 0.06em;\n",
        "            text-transform: uppercase;\n",
        "            color: var(--color-primary);\n",
        "        }\n",
        "\n",
        "        .progress-pct-value {\n",
        "            font-size: 15px;\n",
        "            font-weight: 600;\n",
        "            color: var(--color-primary);\n",
        "            font-variant-numeric: tabular-nums;\n",
        "        }\n",
        "\n",
        "        .progress-step-desc {\n",
        "            font-size: 13.5px;\n",
        "            font-weight: 400;\n",
        "            line-height: 1.45;\n",
        "            color: var(--color-ink-muted-80);\n",
        "            margin: 0;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stProgress\"] {\n",
        "            margin-top: 2px !important;\n",
        "            margin-bottom: 8px !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stProgress\"] div[role=\"progressbar\"] {\n",
        "            background-color: var(--color-track) !important;\n",
        "            border-radius: var(--radius-pill) !important;\n",
        "            height: 8px !important;\n",
        "            overflow: hidden !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stProgress\"] div[role=\"progressbar\"] > div {\n",
        "            background-color: var(--color-primary) !important;\n",
        "            border-radius: var(--radius-pill) !important;\n",
        "            height: 100% !important;\n",
        "            transition: width 0.24s cubic-bezier(0.25, 0.1, 0.25, 1) !important;\n",
        "        }\n",
        "\n",
        "        /* ======================================================================\n",
        "           [Streamlit 프론트엔드 TypeError 및 시스템 예외 박스(stException/stAlert) 정돈]\n",
        "           기존의 어두운 붉은색 에러 박스와 빈 코드 블록을 제거하고 깔끔한 안내 카드로 변환\n",
        "           ====================================================================== */\n",
        "        [data-testid=\"stException\"],\n",
        "        [data-testid=\"stAlert\"],\n",
        "        [data-testid=\"stAlertContainer\"],\n",
        "        [data-testid=\"stNotification\"],\n",
        "        div[data-baseweb=\"notification\"] {\n",
        "            background-color: var(--color-parchment) !important;\n",
        "            color: var(--color-ink) !important;\n",
        "            border: 1px solid var(--color-hairline) !important;\n",
        "            border-left: 3px solid var(--color-primary) !important;\n",
        "            border-radius: var(--radius-md) !important;\n",
        "            padding: 14px 16px !important;\n",
        "            margin: 10px 0 !important;\n",
        "            box-shadow: none !important;\n",
        "        }\n",
        "\n",
        "        /* 중첩 알림 래퍼의 이중 테두리 및 중복 여백 제거 */\n",
        "        [data-testid=\"stAlert\"] div[data-baseweb=\"notification\"],\n",
        "        [data-testid=\"stAlertContainer\"] div[data-baseweb=\"notification\"],\n",
        "        [data-testid=\"stException\"] div[data-baseweb=\"notification\"],\n",
        "        div[data-baseweb=\"notification\"] [data-testid=\"stException\"],\n",
        "        [data-testid=\"stNotificationContentError\"] {\n",
        "            background-color: transparent !important;\n",
        "            border: none !important;\n",
        "            border-left: none !important;\n",
        "            padding: 0 !important;\n",
        "            margin: 0 !important;\n",
        "            box-shadow: none !important;\n",
        "        }\n",
        "\n",
        "        /* 에러 본문 글씨체 및 긴 모듈 URL 자동 줄바꿈 처리 */\n",
        "        [data-testid=\"stException\"] *,\n",
        "        [data-testid=\"stAlert\"] *,\n",
        "        div[data-baseweb=\"notification\"] * {\n",
        "            color: var(--color-ink-muted-80) !important;\n",
        "            font-family: var(--font-sans) !important;\n",
        "            font-size: 13px !important;\n",
        "            line-height: 1.55 !important;\n",
        "            overflow-wrap: anywhere !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stException\"] strong,\n",
        "        [data-testid=\"stException\"] b,\n",
        "        div[data-baseweb=\"notification\"] strong,\n",
        "        div[data-baseweb=\"notification\"] b,\n",
        "        [data-testid=\"stException\"] .type {\n",
        "            color: var(--color-ink) !important;\n",
        "            font-weight: 600 !important;\n",
        "        }\n",
        "\n",
        "        /* TypeError 발생 시 하단에 생성되는 비어 있는 스택 트레이스(pre) 영역 완전 숨김 */\n",
        "        [data-testid=\"stException\"] pre,\n",
        "        [data-testid=\"stAlert\"] pre,\n",
        "        div[data-baseweb=\"notification\"] pre {\n",
        "            background-color: var(--color-canvas) !important;\n",
        "            border: 1px solid var(--color-hairline) !important;\n",
        "            border-radius: var(--radius-sm) !important;\n",
        "            padding: 10px 12px !important;\n",
        "            margin-top: 8px !important;\n",
        "            font-size: 12px !important;\n",
        "            color: var(--color-ink-muted-48) !important;\n",
        "            max-height: 110px !important;\n",
        "            overflow-y: auto !important;\n",
        "        }\n",
        "\n",
        "        [data-testid=\"stException\"] pre:empty,\n",
        "        [data-testid=\"stAlert\"] pre:empty,\n",
        "        div[data-baseweb=\"notification\"] pre:empty,\n",
        "        [data-testid=\"stException\"] pre:has(code:empty),\n",
        "        [data-testid=\"stAlert\"] pre:has(code:empty),\n",
        "        div[data-baseweb=\"notification\"] pre:has(code:empty) {\n",
        "            display: none !important;\n",
        "        }\n",
        "\n",
        "        /* 모듈 로딩 지연(TypeError) 박스 하단에 직관적인 복구 안내 문구 자동 부착 */\n",
        "        div[data-baseweb=\"notification\"]::after,\n",
        "        [data-testid=\"stException\"]:not(:has(div[data-baseweb=\"notification\"])):not(div[data-baseweb=\"notification\"] *)::after {\n",
        "            content: \"일시적인 터널 네트워크 지연으로 일부 화면 모듈 응답이 지연되었습니다. 페이지 새로고침(Ctrl + Shift + R)을 실행하면 즉시 복구됩니다.\";\n",
        "            display: block;\n",
        "            margin-top: 10px;\n",
        "            padding-top: 10px;\n",
        "            border-top: 1px solid var(--color-hairline);\n",
        "            font-size: 12.5px;\n",
        "            font-weight: 600;\n",
        "            line-height: 1.45;\n",
        "            color: var(--color-primary);\n",
        "            word-break: keep-all;\n",
        "        }\n",
        "\n",
        "        /* 커스텀 인라인 안내 및 파이썬 예외 카드 */\n",
        "        .inline-notice {\n",
        "            padding: 15px 18px;\n",
        "            border-radius: var(--radius-md);\n",
