        "# ==============================================================================\n",
        "# [4. 실시간 프로그래스 바 렌더러 및 사용자 친화적 예외 포매터]\n",
        "# st.progress()와 고정폭 퍼센트 헤더를 결합하여 진행률을 직관적으로 시각화하고,\n",
        "# 백엔드 TypeError 등 모든 예외를 정돈된 안내 문구로 변환합니다.\n",
        "# ==============================================================================\n",
        "def create_progress_updater(status_slot, bar_slot, stage_badge: str):\n",
        "    \"\"\"지정된 슬롯에 단계별 진행 텍스트와 st.progress 바(0~100%)를 실시간 갱신하는 클로저를 반환합니다.\"\"\"\n",
        "    progress_widget = bar_slot.progress(0)\n",
        "\n",
        "    def update(percent: int, description: str) -> None:\n",
        "        clamped = max(0, min(100, int(percent)))\n",
        "        status_slot.markdown(\n",
        "            f\"\"\"\n",
        "            <div class=\"progress-tracker-header\">\n",
        "                <div class=\"progress-meta-top\">\n",
        "                    <span class=\"progress-stage-badge\">{stage_badge}</span>\n",
        "                    <span class=\"progress-pct-value\">{clamped}%</span>\n",
        "                </div>\n",
        "                <p class=\"progress-step-desc\">{description}</p>\n",
        "            </div>\n",
        "            \"\"\",\n",
        "            unsafe_allow_html=True,\n",
        "        )\n",
        "        progress_widget.progress(clamped)\n",
        "\n",
        "    return update\n",
        "\n",
        "\n",
        "def format_exception_notice(exc: Exception) -> tuple[str, str]:\n",
        "    \"\"\"시스템 날것의 트레이스백 대신 원인과 해결 행동이 명확한 제목·본문 쌍을 반환합니다.\"\"\"\n",
        "    if isinstance(exc, TypeError):\n",
        "        return (\n",
        "            \"데이터 형식 처리 예외 (TypeError)\",\n",
        "            f\"입력 데이터 또는 API 응답 형식을 변환하는 중 형식 불일치가 감지되었습니다. 이미지를 다시 확인하거나 페이지를 새로고침한 뒤 재시도해 주십시오. ({exc})\",\n",
        "        )\n",
        "    return (\"작업 처리 안내\", str(exc))\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# [5. Pillow(PIL) 기반 이미지 최적화 모듈]\n",
        "# Image.open()과 .thumbnail((1200, 1200))을 사용하여 스마트폰 고해상도 사진의\n",
        "# 회전 메타데이터를 보정하고 API 전송 속도 및 안정성을 최적화합니다.\n",
        "# ==============================================================================\n",
        "def optimize_uploaded_image(uploaded_file) -> tuple[Image.Image, tuple[int, int]]:\n",
        "    \"\"\"업로드된 이미지 파일을 열어 최대 1200x1200 크기로 비율 유지 리사이징을 수행합니다.\"\"\"\n",
        "    uploaded_file.seek(0)\n",
        "    image = Image.open(uploaded_file)\n",
        "\n",
        "    # 스마트폰 촬영 사진의 EXIF 방향 정보 보정\n",
        "    image = ImageOps.exif_transpose(image)\n",
        "\n",
        "    # 투명 채널(RGBA/P) 이미지를 표준 RGB 모드로 변환하여 호환성 확보\n",
        "    if image.mode not in (\"RGB\", \"L\"):\n",
        "        image = image.convert(\"RGB\")\n",
        "\n",
        "    # 원본 가로·세로 비율을 유지한 채 최대 (1200, 1200) 이하로 축소\n",
        "    image.thumbnail(MAX_IMAGE_SIZE)\n",
        "    return image, image.size\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# [6. API 모델 자동 탐색 및 스트리밍 예외 처리 (call_gemini_safe 함수)]\n",
        "# client.models.list()로 현재 키에서 사용 가능한 최신 Gemini Flash 모델을 자동 선택하고,\n",
        "# 실시간 스트리밍 수신량에 맞춰 프로그래스 바를 갱신하며 503/429 재시도 및 404 전환을 수행합니다.\n",
        "# ==============================================================================\n",
        "def discover_flash_models(client: genai.Client) -> list[str]:\n",
        "    \"\"\"사용 가능한 Gemini Flash 계열 텍스트·멀티모달 모델을 최신 버전순으로 반환합니다.\"\"\"\n",
        "    excluded_tokens = (\n",
        "        \"embedding\",\n",
        "        \"imagen\",\n",
        "        \"tts\",\n",
        "        \"veo\",\n",
        "        \"aqa\",\n",
        "        \"audio\",\n",
        "        \"live\",\n",
        "        \"robotics\",\n",
        "        \"computer-use\",\n",
        "        \"image\",\n",
        "    )\n",
        "    discovered = []\n",
        "\n",
        "    try:\n",
        "        for model_info in client.models.list():\n",
        "            raw_name = getattr(model_info, \"name\", \"\") or \"\"\n",
        "            model_id = raw_name.replace(\"models/\", \"\").strip()\n",
        "            lower_id = model_id.lower()\n",
        "\n",
        "            if \"gemini\" not in lower_id or \"flash\" not in lower_id:\n",
        "                continue\n",
        "            if any(token in lower_id for token in excluded_tokens):\n",
        "                continue\n",
        "\n",
        "            supported_actions = getattr(model_info, \"supported_actions\", None)\n",
        "            if supported_actions and \"generateContent\" not in supported_actions:\n",
        "                continue\n",
        "\n",
        "            if model_id not in discovered:\n",
        "                discovered.append(model_id)\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    def version_sort_key(model_id: str) -> tuple:\n",
        "        lower_id = model_id.lower()\n",
        "        match = re.search(r\"gemini-(\\d+)(?:\\.(\\d+))?\", lower_id)\n",
        "        major = int(match.group(1)) if match else 0\n",
        "        minor = int(match.group(2)) if (match and match.group(2) is not None) else 0\n",
        "        is_standard_flash = 0 if \"lite\" in lower_id else 1\n",
        "        is_stable = 0 if (\"preview\" in lower_id or \"exp\" in lower_id) else 1\n",
        "        is_latest_alias = 1 if lower_id == \"gemini-flash-latest\" else 0\n",
        "        return (major, minor, is_standard_flash, is_stable, is_latest_alias)\n",
        "\n",
        "    discovered.sort(key=version_sort_key, reverse=True)\n",
        "\n",
        "    fallback_models = [\n",
        "        \"gemini-2.5-flash\",\n",
        "        \"gemini-2.0-flash\",\n",
        "        \"gemini-flash-latest\",\n",
        "    ]\n",
        "    for fb in fallback_models:\n",
        "        if fb not in discovered:\n",
        "            discovered.append(fb)\n",
        "\n",
        "    return discovered\n",
        "\n",
        "\n",
        "def call_gemini_safe(\n",
        "    client: genai.Client,\n",
        "    contents: list,\n",
        "    system_instruction: str = \"\",\n",
        "    temperature: float = 0.2,\n",
        "    max_retries: int = 3,\n",
        "    on_progress=None,\n",
        "    progress_range: tuple[int, int] = (30, 92),\n",
        "    expected_chars: int = 850,\n",
        "    milestone_markers: list[tuple[str, int, str]] | None = None,\n",
        ") -> tuple[str, str]:\n",
        "    \"\"\"\n",
        "    최신 Flash 모델 자동 탐색, 실시간 스트리밍 진행률 업데이트 및 오류 방어 호출 함수:\n",
        "    - 503(UNAVAILABLE) 또는 429(RESOURCE_EXHAUSTED): 대기 카운트다운 표시 후 자동 재시도\n",
        "    - 404(NOT_FOUND): 지원 종료·미지원 모델로 판단하고 다음 후보 모델로 즉시 전환\n",
        "    \"\"\"\n",
        "    start_pct, end_pct = progress_range\n",
        "    if on_progress:\n",
        "        on_progress(start_pct, \"사용 가능한 최신 Gemini Flash 모델을 자동 탐색하고 있습니다...\")\n",
        "\n",
        "    candidate_models = discover_flash_models(client)\n",
        "    config = types.GenerateContentConfig(\n",
        "        system_instruction=system_instruction if system_instruction else None,\n",
        "        temperature=temperature,\n",
        "    )\n",
        "\n",
        "    last_error_detail = \"\"\n",
        "\n",
        "    for model_name in candidate_models:\n",
        "        for attempt in range(1, max_retries + 1):\n",
        "            req_pct = min(end_pct - 6, start_pct + 8)\n",
        "            if on_progress:\n",
        "                on_progress(req_pct, f\"{model_name} 모델에 멀티모달 데이터를 전송하고 응답을 대기 중입니다...\")\n",
        "\n",
        "            try:\n",
        "                stream = client.models.generate_content_stream(\n",
        "                    model=model_name,\n",
        "                    contents=contents,\n",
        "                    config=config,\n",
        "                )\n",
        "\n",
        "                collected_chunks: list[str] = []\n",
        "                accumulated_text = \"\"\n",
        "                current_pct = req_pct\n",
        "                last_ui_update = 0.0\n",
        "\n",
        "                for chunk in stream:\n",
        "                    try:\n",
        "                        piece = chunk.text or \"\"\n",
        "                    except Exception:\n",
        "                        piece = \"\"\n",
        "\n",
        "                    if not piece:\n",
        "                        continue\n",
        "\n",
        "                    collected_chunks.append(piece)\n",
        "                    accumulated_text += piece\n",
        "\n",
        "                    # 수신된 글자 수 비율 및 사고 과정(CoT) 섹션 도달 여부에 따라 진행률 계산\n",
        "                    char_ratio = min(1.0, len(accumulated_text) / max(1, expected_chars))\n",
        "                    computed_pct = int(req_pct + 4 + (end_pct - req_pct - 4) * char_ratio)\n",
        "                    current_pct = max(current_pct, min(end_pct, computed_pct))\n",
        "\n",
        "                    stage_label = f\"{model_name} 실시간 스트리밍 수신 중 ({len(accumulated_text):,}자 처리됨)\"\n",
        "                    if milestone_markers:\n",
        "                        for marker_token, marker_pct, marker_desc in milestone_markers:\n",
        "                            if marker_token in accumulated_text:\n",
        "                                current_pct = max(current_pct, min(end_pct, marker_pct))\n",
        "                                stage_label = marker_desc\n",
        "\n",
        "                    # 터널 대역폭 보호를 위해 0.14초 간격으로 부드럽게 프로그래스 바 갱신\n",
        "                    now = time.monotonic()\n",
        "                    if on_progress and (now - last_ui_update >= 0.14):\n",
        "                        on_progress(current_pct, stage_label)\n",
        "                        last_ui_update = now\n",
        "\n",
        "                final_text = \"\".join(collected_chunks).strip()\n",
        "                if final_text:\n",
        "                    if on_progress:\n",
        "                        on_progress(end_pct, f\"{model_name} 응답 수신 완료 — 수식 정규화 및 결과 구성을 마무리합니다.\")\n",
        "                    return final_text, model_name\n",
        "\n",
        "                last_error_detail = f\"{model_name}: 응답 본문이 비어 있습니다.\"\n",
        "                break\n",
        "\n",
        "            except Exception as exc:\n",
        "                err_str = str(exc)\n",
        "                err_upper = err_str.upper()\n",
        "\n",
        "                # API 키 인증 오류는 재시도 없이 즉시 안내\n",
        "                if any(\n",
        "                    auth_code in err_upper\n",
        "                    for auth_code in (\"API_KEY_INVALID\", \"INVALID_ARGUMENT: API KEY\", \"401\", \"PERMISSION_DENIED\")\n",
        "                ):\n",
        "                    raise RuntimeError(\n",
        "                        \"API 키 인증에 실패했습니다. 코드 상단의 GEMINI_API_KEY 또는 사이드바 입력 키가 유효한지 확인해 주십시오.\"\n",
        "                    ) from exc\n",
        "\n",
        "                # 404 에러 시 다음 후보 모델로 즉시 자동 전환\n",
        "                if \"404\" in err_upper or \"NOT_FOUND\" in err_upper:\n",
        "                    last_error_detail = f\"{model_name} 모델을 찾을 수 없어 다음 후보 모델로 전환했습니다.\"\n",
        "                    if on_progress:\n",
        "                        on_progress(start_pct + 5, f\"{model_name} 지원 종료 감지 — 다음 후보 Flash 모델로 자동 전환합니다...\")\n",
        "                    break\n",
        "\n",
        "                # 503 서버 혼잡 또는 429 호출 제한 시 2.5초 대기 카운트다운 표시 후 재시도\n",
        "                if any(\n",
        "                    transient in err_upper\n",
        "                    for transient in (\"503\", \"429\", \"UNAVAILABLE\", \"RESOURCE_EXHAUSTED\", \"OVERLOADED\")\n",
        "                ):\n",
        "                    last_error_detail = f\"{model_name} 서버 혼잡 또는 호출 제한이 감지되었습니다.\"\n",
        "                    if attempt < max_retries:\n",
        "                        for step_idx in range(5):\n",
        "                            remain_sec = 2.5 - (step_idx * 0.5)\n",
        "                            if on_progress:\n",
        "                                on_progress(\n",
        "                                    req_pct,\n",
        "                                    f\"서버 혼잡(503/429) 감지 — {remain_sec:.1f}초 후 자동 재시도합니다 ({attempt}/{max_retries})\",\n",
        "                                )\n",
        "                            time.sleep(0.5)\n",
        "                        continue\n",
        "                    break\n",
        "\n",
        "                last_error_detail = err_str\n",
        "                break\n",
        "\n",
        "    raise RuntimeError(\n",
        "        f\"현재 사용 가능한 Gemini Flash 모델 호출에 모두 실패했습니다. 잠시 후 다시 시도해 주십시오. (상세 원인: {last_error_detail})\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ==============================================================================\n",
        "# [7. 프롬프트 엔지니어링 및 텍스트 정제 모듈]\n",
        "# 0단계(시각적 환각 방어용 수식·풀이 추출)와 1단계(4대 태그·CoT·퓨샷 기반 정밀 진단)\n",
        "# 시스템 프롬프트를 전공 과목 페르소나에 맞춰 동적으로 생성합니다.\n",
        "# ==============================================================================\n",
        "def clean_output_text(text: str) -> str:\n",
        "    \"\"\"LaTeX 수식 구분자를 Streamlit 표준($, $$)으로 정규화하고 불필요한 그림 문자를 제거합니다.\"\"\"\n",
        "    if not text:\n",
        "        return \"\"\n",
        "    cleaned = re.sub(r\"\\\\\\((.*?)\\\\\\)\", r\"$\\1$\", text, flags=re.DOTALL)\n",
        "    cleaned = re.sub(r\"\\\\\\[(.*?)\\\\\\]\", r\"$$\\1$$\", cleaned, flags=re.DOTALL)\n",
        "    cleaned = re.sub(r\"[\\U0001F300-\\U0001FAFF\\u2600-\\u26FF\\u2700-\\u27BF]\", \"\", cleaned)\n",
        "    return cleaned.strip()\n",
        "\n",
        "\n",
        "def build_ocr_system_prompt(subject_name: str) -> str:\n",
        "    \"\"\"0단계 AI 이미지 판독을 위한 시스템 지시문을 생성합니다.\"\"\"\n",
        "    persona = SUBJECT_PERSONAS[subject_name]\n",
        "    return f\"\"\"당신은 '{subject_name}' 과목의 수식과 손글씨 풀이를 정밀 판독하는 {persona['role']}입니다.\n",
        "사용자가 업로드한 이미지에서 텍스트와 수식을 정확하게 추출하여 검수용 초안을 작성하십시오.\n",
        "\n",
        "[판독 원칙]\n",
        "1. 글씨가 흐릿하거나 겹쳐서 숫자, 첨자, 부호, 변수명이 애매한 부분은 절대 임의로 추측하여 메우지 말고 반드시 `[판독 불확실]`로 표기하십시오.\n",
        "2. 모든 수학·물리 수식, 변수, 단위는 가독성과 편집 편의성을 위해 LaTeX 인라인(`$...$`) 또는 블록(`$$...$$`) 문법으로 표기하십시오.\n",
        "3. 이모지(Emoji)나 감탄사는 일절 사용하지 말고 아래 지정된 형식만 간결하게 출력하십시오.\n",
        "\n",
        "[출력 형식]\n",
        "[문제 요약 및 주어진 조건]\n",
        "- 문제의 핵심 질문과 주어진 수치·단위·제약 조건을 항목별로 정리\n",
        "\n",
        "[학생 손글씨 풀이 과정]\n",
        "- 1번째 줄: (추출된 수식 및 서술)\n",
        "- 2번째 줄: (추출된 수식 및 서술)\n",
        "(풀이 이미지가 제공되지 않은 경우 반드시 '풀이 사진 없음' 한 줄만 기재)\"\"\"\n",
        "\n",
        "\n",
        "def build_diagnosis_system_prompt(subject_name: str) -> str:\n",
        "    \"\"\"1단계 오답 원인 정밀 진단 및 유사 변형 문제 생성을 위한 시스템 프롬프트를 생성합니다.\"\"\"\n",
        "    persona = SUBJECT_PERSONAS[subject_name]\n",
