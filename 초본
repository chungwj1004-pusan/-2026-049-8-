        "\n",
        "### 3. 핵심 개념 리마인드 및 복습 전략\n",
        "- 놓친 전공 개념의 정확한 수식적 정의와 시험·과제 실전 점검 체크리스트\n",
        "\n",
        "### 4. 맞춤형 유사 변형 문제\n",
        "- 동일 개념·난이도의 변형 문제 지문 및 조건 제시 (정답 미포함)\n",
        "\n",
        "{SOLUTION_DIVIDER}\n",
        "\n",
        "### 변형 문제 정답 및 단계별 해설\n",
        "- 최종 정답: (단위 및 수식 포함 명확히 표기)\n",
        "- 단계별 상세 풀이 과정\"\"\"\n",
        "\n",
        "\n",
        "def parse_diagnosis_response(raw_text: str) -> tuple[str, str, list[str]]:\n",
        "    \"\"\"진단 응답에서 표준 태그를 추출하고 본문과 변형 문제 해설 영역을 분리합니다.\"\"\"\n",
        "    cleaned = clean_output_text(raw_text)\n",
        "\n",
        "    if SOLUTION_DIVIDER in cleaned:\n",
        "        parts = cleaned.split(SOLUTION_DIVIDER, maxsplit=1)\n",
        "        main_body = parts[0].strip()\n",
        "        solution_body = parts[1].strip()\n",
        "    else:\n",
        "        fallback_split = re.split(\n",
        "            r\"(?:^|\\n)#+\\s*(?:변형\\s*문제\\s*정답|정답\\s*및\\s*(?:단계별\\s*)?해설)\",\n",
        "            cleaned,\n",
        "            maxsplit=1,\n",
        "        )\n",
        "        if len(fallback_split) == 2:\n",
        "            main_body = fallback_split[0].strip()\n",
        "            solution_body = \"### 변형 문제 정답 및 단계별 해설\\n\" + fallback_split[1].strip()\n",
        "        else:\n",
        "            main_body = cleaned\n",
        "            solution_body = \"변형 문제 해설이 본문에 통합 생성되었습니다. 위 진단 리포트 하단을 확인해 주십시오.\"\n",
        "\n",
        "    found_tags = [tag for tag in ERROR_TAGS if tag in main_body]\n",
        "    if not found_tags:\n",
        "        found_tags = [tag for tag in ERROR_TAGS if tag in cleaned]\n",
        "\n",
        "    return main_body, solution_body, found_tags\n",
        "\n",
        "\n",
